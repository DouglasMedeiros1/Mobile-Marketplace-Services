# Exemplo de variáveis de ambiente para o backend
# Copie este arquivo para .env e preencha com seus valores

# Configuração do servidor
NODE_ENV=development
PORT=3000

# Banco de dados PostgreSQL/Supabase
# Formato: postgresql://user:password@host:port/database
DB_CONNECTION_STRING=postgresql://user:password@host:port/database

# Alternativa (usada pelo código atual):
# Copie e substitua [YOUR_PASSWORD] pelo password real do seu projeto Supabase
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.myjxlwoizaqecbhufbtx.supabase.co:5432/postgres
# JWT Secret (use uma string aleatória segura em produção)
JWT_SECRET=your-secret-key-here

# CORS (opcional - domínios permitidos)
# CORS_ORIGIN=http://localhost:3000
